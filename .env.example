# Node 22+: node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=4178
APEX_DATA_DIR=./data/decisions
# Browser origins allowed to call a remote Qevor backend.
APEX_CORS_ORIGINS=http://127.0.0.1:4177,http://localhost:4177
# Set true on the public Vercel API. Keep false only on a private loopback VPS.
APEX_PUBLIC_READ_ONLY=true
OLLAMA_ENABLED=false
# On Qevor use existing private service. Verify installed model before enabling.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# External Bear: exact HTTPS chat-completions URL, server-side credential, model.
BEAR_API_URL=
BEAR_API_KEY=
BEAR_MODEL=
BINANCE_LIVE_EXECUTION=false
# Optional authorized MCP access for READ-ONLY tool discovery; never commit.
BINANCE_MCP_ACCESS_TOKEN=
# OAuth values for the dashboard's Connect Binance button. The redirect URI
# must exactly match the URI registered with Binance, e.g. https://your-domain/api/binance/callback.
BINANCE_OAUTH_CLIENT_ID=
BINANCE_OAUTH_REDIRECT_URI=
BINANCE_OAUTH_SCOPES=account trade
# Optional server-side Spot REST adapter. Store only on Qevor, never in the browser.
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Both flags remain false until Guardian integration and limits are reviewed.
BINANCE_REST_WRITES=false
BINANCE_AUTOPILOT_ENABLED=false
BINANCE_MAX_ORDER_NOTIONAL_USDT=
BINANCE_ALLOWED_SYMBOLS=
BINANCE_EMERGENCY_STOP_FILE=/opt/apex-agent/AUTOPILOT_STOP
